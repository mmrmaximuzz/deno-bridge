{
    "tasks": {
        "test:unit": "deno test",
        "test:e2e": "deno test --allow-net='localhost:9000' backend/tests/websocket_e2e.ts",
        "harness": "deno check && deno task 'test:*' && deno lint && deno fmt",
        "build": "deno bundle --platform browser --output static/main.js frontend/main.ts",
        "run-debug": "deno task build && sh scripts/gencert.sh && deno run --allow-read=server.key,server.crt,static --allow-net=127.0.0.1:60000 backend/main.ts debug"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@std/http": "jsr:@std/http@^1.1.3"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": false,
        "lineWidth": 100
    },
    "compilerOptions": {
        "checkJs": true,
        "lib": ["dom", "deno.ns"]
    }
}
