{
    "tasks": {
        "harness": "deno check && deno test && deno lint && deno fmt",
        "dev": "deno run --watch main.ts"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@std/http": "jsr:@std/http@^1.0.25"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": false,
        "lineWidth": 100
    },
    "compilerOptions": {
        "checkJs": true,
        "lib": ["dom", "deno.ns"]
    }
}
